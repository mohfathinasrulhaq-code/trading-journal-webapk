# Salin file ini menjadi .env.local lalu isi nilainya.
# Ambil nilai dari Supabase Dashboard > Project Settings > API.

# Project URL, contoh: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci PUBLIK saja: anon key (JWT) atau publishable key (sb_publishable_...).
# JANGAN pernah memakai service_role key atau secret key (sb_secret_...) di sini.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
